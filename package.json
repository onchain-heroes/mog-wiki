{
  "name": "mog-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight player field guide for MoG V2.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/check-content.mjs && astro build && node scripts/check-output.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "validate": "pnpm format:check && pnpm check && pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.1",
    "astro": "7.3.3"
  }
}
