---
import Sprite from './Sprite.astro';
import type { Rarity } from '../i18n/rarities';

interface Props {
  id: string;
  rarity: Rarity;
  label: string;
  size?: number;
}

const { id, rarity, label, size = 88 } = Astro.props;
---

<span
  class="talent-icon"
  data-rarity={rarity}
  style={`--talent-size:${size}px`}
>
  <Sprite {id} {label} {size} />
</span>

<style>
  .talent-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--talent-size);
    height: var(--talent-size);
    border-radius: 12px;
    background: linear-gradient(
      180deg,
      var(--rarity-top),
      var(--rarity-bottom)
    );
    box-shadow:
      inset 0 3px 0 rgba(255, 255, 255, 0.45),
      inset 0 -3px 0 var(--rarity-edge),
      inset 3px 0 0 var(--rarity-edge),
      inset -3px 0 0 var(--rarity-edge),
      0 3px 6px rgba(0, 0, 0, 0.35);
  }
  [data-rarity='uncommon'] {
    --rarity-top: #86efac;
    --rarity-bottom: #4ade80;
    --rarity-edge: #15803d;
  }
  [data-rarity='rare'] {
    --rarity-top: #93c5fd;
    --rarity-bottom: #3b82f6;
    --rarity-edge: #1d4ed8;
  }
  [data-rarity='epic'] {
    --rarity-top: #c084fc;
    --rarity-bottom: #9333ea;
    --rarity-edge: #6b21a8;
  }
  [data-rarity='legendary'] {
    --rarity-top: #fdba74;
    --rarity-bottom: #f97316;
    --rarity-edge: #c2410c;
  }
</style>
