---
import { Icon } from '@astrojs/starlight/components';
import { getLocale, localizedPath, ui } from '../i18n/ui';

const locale = getLocale(Astro.locals.starlightRoute.lang);
const t = ui[locale];
---

<a class="brand" href={localizedPath('/', locale)} aria-label={t.homeLabel}>
  <span class="brand-mark" aria-hidden="true">
    <Icon name="open-book" size="22" />
  </span>
  <span>
    MoG <span class="brand-subtitle">{t.siteSubtitle}</span>
  </span>
  <span class="version">V2</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--sl-color-white);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .brand-mark {
    display: flex;
    color: var(--sl-color-text-accent);
  }
  .brand-subtitle {
    font-weight: 450;
  }
  .version {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.3rem;
    padding: 0.05rem 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }
  @media (max-width: 360px) {
    .version {
      display: none;
    }
  }
</style>
