---
import { getLocale } from '../i18n/ui';
import { roomText } from '../i18n/rooms';
import captures from '../data/captures.json';
interface Props {
  room: keyof typeof captures.rooms;
}
const { room } = Astro.props;
const t = roomText[getLocale(Astro.locals.starlightRoute.lang)];
const { width, height } = captures.rooms[room];
---

<figure class="room-capture" data-room={room}>
  <img
    src={`/media/rooms/${room}.webp`}
    width={width}
    height={height}
    alt={t.alt[room]}
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    {t[room]} <span>{room === 'unknown-trainer' ? t.trainerNote : t.note}</span>
  </figcaption>
</figure>

<style>
  .room-capture {
    margin: 1.5rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.65rem;
    overflow: hidden;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  figcaption {
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
    line-height: 1.7;
  }
  figcaption span {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
  }
</style>
